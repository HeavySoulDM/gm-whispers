{
  "_comment": "Как классифицировать журналы. Проверяется по строке «Папка / Название журнала», по порядку, первое совпадение побеждает. weight — множитель релевантности при поиске (приоритет: материалы ГМа > книга приключения > справочник мира). exclude — не индексировать.",
  "rules": [
    {
      "match": "^CPR|Авторы$|AG D&D 2024|^Служебные материалы",
      "exclude": true
    },
    {
      "match": "^Компендиум · .* / (Иллюстрации|AG Fifthpendium •|Art Handouts)",
      "exclude": true
    },
    {
      "match": "^Компендиум · ",
      "source": "rules5e",
      "label": "Правила D&D 2024",
      "weight": 0.9
    },
    {
      "match": "Дневник кампании",
      "source": "diary",
      "label": "Дневник кампании",
      "weight": 1.35
    },
    {
      "match": "ДМ •|База НПС|памятка|Квенты|Заметки на полях",
      "source": "gm",
      "label": "Материалы ГМа",
      "weight": 1.3
    },
    {
      "match": "Глава \\d+ —|Дополнение [А-Я]",
      "source": "adventure",
      "label": "Книга приключения",
      "weight": 1.15
    },
    {
      "match": "Глава \\d+:|Приложение [A-ZА-Я]",
      "source": "setting",
      "label": "Справочник мира",
      "weight": 1.0
    },
    {
      "match": "оздание персонажа",
      "source": "rules",
      "label": "Создание персонажа",
      "weight": 0.8
    }
  ],
  "default": {
    "source": "other",
    "label": "Прочие журналы",
    "weight": 1.0
  }
}