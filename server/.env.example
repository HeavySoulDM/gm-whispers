# Настройки сервера GM Whispers. setup.bat копирует этот файл в .env.
# .env никому не показывай и не клади в мир Foundry.
#
# Почти всё отсюда удобнее задавать из Foundry: панель GM Whispers → ⚙ «Настройки сервера».
# Окно пишет в этот же .env, перезапуск сервера не нужен.

# --- Ключи API. Достаточно одного: модели подберутся сами (auto).
# Claude: console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# OpenAI: platform.openai.com → API keys
OPENAI_API_KEY=
# Gemini: aistudio.google.com → Get API key
GEMINI_API_KEY=
# DeepSeek: platform.deepseek.com → API keys
DEEPSEEK_API_KEY=
# OpenRouter: openrouter.ai → Keys (сотни моделей через один ключ)
OPENROUTER_API_KEY=
# Свой провайдер с API, совместимым с OpenAI (RouterAI, локальные серверы и т. п.)
CUSTOM_NAME=
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# --- Модели по ролям. auto — по первому заданному ключу (порядок: Claude, OpenAI, Gemini, DeepSeek, OpenRouter, свой).
# Формат «провайдер:модель»: openrouter:anthropic/claude-sonnet-4.5, gemini:gemini-2.5-pro, deepseek:deepseek-chat, custom:имя.
# Для Claude и OpenAI префикс не нужен. Провайдеров можно смешивать по ролям.
GMW_MODEL_LORE=auto
GMW_MODEL_TACTICS=auto
GMW_MODEL_FAST=auto
# Глубина размышлений моделей OpenAI: none / low / medium / high (пусто — по умолчанию модели).
GMW_OPENAI_REASONING=low
GMW_OPENAI_REASONING_FAST=none

# --- Запись голоса (Craig)
# Папка, куда облако (Google Drive / Dropbox / OneDrive) синхронизирует записи. Пусто — только вручную через transcribe.bat.
GMW_CRAIG_INBOX=
# 1 — следить за папкой самому раз в минуту; 0 — забирать по кнопке в «Итогах».
GMW_CRAIG_AUTO=0
# Модель распознавания faster-whisper: large-v3-turbo (по умолчанию), large-v3, medium…
GMW_WHISPER_MODEL=large-v3-turbo

# --- Discord (для будущих подсказок в реальном времени; сейчас не используется)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TEST_VOICE_CHANNEL_ID=
DISCORD_OWNER_ID=

# --- Сервер
GMW_HOST=127.0.0.1
GMW_PORT=8765
# GMW_LOCAL_TOKEN сервер создаст сам при первом запуске и допишет сюда.
